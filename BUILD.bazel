genrule(
    name = "java_projection",
    srcs = [
        "//src/native/schema-codegen:generated/api.schema.json",
        "//src/native/schema-codegen:generated/session-events.schema.json",
        "java/scripts/codegen/fetch-schemas.mjs",
        "java/scripts/codegen/java.ts",
        "java/scripts/codegen/package-lock.json",
        "java/scripts/codegen/package.json",
        "nodejs/package.json",
        "scripts/runtime-layout.mjs",
    ],
    outs = ["projections/java.tar"],
    cmd = """
set -eu
execroot="$$PWD"
archive_root="$$execroot/$(@D)/java-root"
root="$$archive_root/java"
schemas="$$execroot/$(@D)/java-schemas"
input_schemas="$$execroot/$$(dirname $(location //src/native/schema-codegen:generated/api.schema.json))"
rm -rf "$$archive_root" "$$schemas"
mkdir -p "$$root" "$$schemas"
codegen_root="$$root"
codegen_schemas="$$schemas"
codegen_input_schemas="$$input_schemas"
if command -v cygpath >/dev/null 2>&1; then
  codegen_root="$$(cygpath -w "$$root")"
  codegen_schemas="$$(cygpath -w "$$schemas")"
  codegen_input_schemas="$$(cygpath -w "$$input_schemas")"
elif pwd -W >/dev/null 2>&1; then
  codegen_root="$$(cd "$$root" && pwd -W)"
  codegen_schemas="$$(cd "$$schemas" && pwd -W)"
  codegen_input_schemas="$$(cd "$$input_schemas" && pwd -W)"
fi
COPILOT_CODEGEN_OUTPUT_ROOT="$$codegen_root" \
COPILOT_CLI_SCHEMA_DIR="$$codegen_input_schemas" \
COPILOT_CLI_SCHEMA_OUTPUT="$$codegen_schemas" \
COPILOT_RUNTIME_SOURCE=checkout \
npm --prefix src/sdk/java/scripts/codegen run generate
tar -cf "$@" -C "$$archive_root" .
""",
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
)
