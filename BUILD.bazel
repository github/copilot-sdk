exports_files(["test/worker-causality.json"])

SHARED_CODEGEN_INPUTS = [
    "nodejs/scripts/releaseArtifacts.ts",
    "nodejs/src/cliVersion.ts",
    "scripts/codegen/package-lock.json",
    "scripts/codegen/package.json",
    "scripts/codegen/utils.ts",
    "scripts/runtime-layout.mjs",
]

HAND_WRITTEN_DOTNET_INPUTS = glob(
    ["dotnet/src/**/*.cs"],
    exclude = [
        "dotnet/src/Generated/**",
        "dotnet/src/bin/**",
        "dotnet/src/obj/**",
    ],
)

HAND_WRITTEN_GO_INPUTS = glob(
    ["go/*.go"],
    exclude = ["go/z*.go"],
)

genrule(
    name = "nodejs_projection",
    srcs = [
        "//src/native/schema-codegen:generated/api.schema.json",
        "//src/native/schema-codegen:generated/session-events.schema.json",
        "scripts/codegen/typescript.ts",
    ] + SHARED_CODEGEN_INPUTS,
    outs = ["projections/nodejs.tar"],
    cmd = """
set -eu
execroot="$$PWD"
root="$$execroot/$(@D)/nodejs-root"
schemas="$$execroot/$$(dirname $(location //src/native/schema-codegen:generated/api.schema.json))"
rm -rf "$$root"
mkdir -p "$$root"
codegen_root="$$root"
codegen_schemas="$$schemas"
if command -v cygpath >/dev/null 2>&1; then
  codegen_root="$$(cygpath -w "$$root")"
  codegen_schemas="$$(cygpath -w "$$schemas")"
elif pwd -W >/dev/null 2>&1; then
  codegen_root="$$(cd "$$root" && pwd -W)"
  codegen_schemas="$$(cd "$$schemas" && pwd -W)"
fi
COPILOT_CODEGEN_OUTPUT_ROOT="$$codegen_root" \
COPILOT_CLI_SCHEMA_DIR="$$codegen_schemas" \
COPILOT_RUNTIME_SOURCE=checkout \
npm --prefix src/sdk/scripts/codegen run generate:ts
tar -cf "$@" -C "$$root" .
""",
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
)

