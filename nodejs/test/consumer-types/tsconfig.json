{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noImplicitAny": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "outDir": "declarations"
    },
    "files": ["extension.mts", "lifecycle.mts"]
}
