# Maintained by bazel/3rdparty/postprocess-local-crates.mjs.
load("//bazel:rust_rules.bzl", "copilot_rust_library_explicit", "copilot_rust_test")

package(default_visibility = ["//visibility:public"])

PLATFORM_DEPS = select({
    "@platforms//os:windows": ["@vendor//:windows-sys"],
    "//conditions:default": [],
})

alias(
    name = "copilot_platform_dirs",
    actual = ":copilot-platform-dirs",
    tags = ["manual"],
)

copilot_rust_library_explicit(
    name = "copilot-platform-dirs",
    srcs = ["//src/sdk/rust:platform_dirs_srcs"],
    crate_name = "copilot_platform_dirs",
    crate_root = "//src/sdk/rust:src/platform_dirs/mod.rs",
    edition = "2024",
    deps = PLATFORM_DEPS,
)

copilot_rust_test(
    name = "copilot-platform-dirs_test",
    crate = ":copilot-platform-dirs",
)
